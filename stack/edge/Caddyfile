{
	auto_https off
}

# Single published origin. Path prefix is CADDY_API_PATH (default /dev-api)
# because the hub already owns /api. Host matcher is CADDY_HOST_MATCHERS
# (unique hostname plus loopback). Do not list EDGE_HOSTNAME next to a
# hardcoded localhost — the default hostname is localhost and Caddy
# refuses a repeated host.
(urantia_edge) {
	encode zstd gzip

	redir {$CADDY_API_PATH} {$CADDY_API_PATH}/
	handle_path {$CADDY_API_PATH}* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {$EDGE_FORWARDED_PROTO}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		reverse_proxy hub:3001 {
			flush_interval -1
			header_up X-Forwarded-Proto {$EDGE_FORWARDED_PROTO}
			header_up X-Forwarded-Host {host}
		}
	}
}

:80 {
	@urantia host {$CADDY_HOST_MATCHERS}
	handle @urantia {
		import urantia_edge
	}

	handle {
		respond "unknown host" 404
	}
}
