########################################################################################################################
# SHARED STACK IDENTITY
########################################################################################################################
# One copy of this repo is one Compose project. Isolates containers, volumes,
# and the networks <name>-apps / <name>-backend.
COMPOSE_PROJECT_NAME=urantialab
COMPOSE_IGNORE_ORPHANS=true

########################################################################################################################
# IN-REPO APP CHECKOUTS (git submodules)
########################################################################################################################
PIPELINE_ROOT=
API_ROOT=
HUB_ROOT=
DATA_SOURCES_ROOT=
BOOK_TREE=

########################################################################################################################
# PUBLISHED IDENTITY (this file only — stack .env files do not copy these keys)
########################################################################################################################
# Caddy is the production ingress. Diagnostic host ports exist for MODE=dev
# overlays; Compose interpolates them from this file, not from stack/.env.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=3000
HUB_HOST_PORT=3001
CADDY_HTTP_PORT=8080
CADDY_API_PATH=/dev-api
CADDY_HOST_MATCHERS=localhost localhost:8080 127.0.0.1 127.0.0.1:8080
EDGE_HOSTNAME=localhost
EDGE_FORWARDED_PROTO=http

########################################################################################################################
# DATABASE
########################################################################################################################
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=urantia
POSTGRES_PASSWORD=
POSTGRES_DB=papers
HUB_DB=hub
PAPERS_DATABASE_URL=
HUB_DATABASE_URL=
PAPERS_DATABASE_URL_HOST=
HUB_DATABASE_URL_HOST=

########################################################################################################################
# REDIS
########################################################################################################################
REDIS_PASSWORD=
REDIS_URL=
REDIS_URL_HOST=

########################################################################################################################
# PUBLIC ORIGINS FOR THIS COPY
########################################################################################################################
EDGE_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080/dev-api
HUB_PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_URANTIA_DEV_API_HOST=http://localhost:8080/dev-api
NEXT_PUBLIC_HOST=http://localhost:8080
NEXT_PUBLIC_AUDIO_FILES_CDN=https://audio.urantiahub.com
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
